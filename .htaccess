AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes

# Block public HTTP access to sensitive configuration, database, and dev files
<FilesMatch "(?i)^(?:config\.local\.php|package(?:-lock)?\.json|ai_work_plan\.md|deploy_infinityfree\.md|\.env(?:\..*)?|\.gitignore|.*\.(?:sql|mjs))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set Content-Security-Policy "upgrade-insecure-requests"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Enforce HTTPS (including mobile / proxy requests) and clean /group routes
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    RewriteRule ^group/$ /group [R=301,L]
    RewriteRule ^group$ group.html [L]
</IfModule>
